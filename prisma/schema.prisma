generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  INSTRUCTOR
  COLLABORATOR
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  PRESENTATION
  DOCUMENT
  TEXT
  QUIZ
}

enum ResourceType {
  PPTX
  PDF
  VIDEO
  IMAGE
  LINK
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  OPEN
  MATCHING
}

enum NotificationType {
  ENROLLMENT
  REMINDER
  GRADE
  CERTIFICATE
  DEADLINE
  SYSTEM
}

model Company {
  id             String          @id @default(cuid())
  name           String          @map("name")
  slug           String          @unique @map("slug")
  logoUrl        String?         @map("logo_url")
  primaryColor   String?         @map("primary_color")
  secondaryColor String?         @map("secondary_color")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  users          User[]
  departments    Department[]
  courseAccess   CourseCompany[]

  @@map("companies")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @map("name")
  companyId String   @map("company_id")
  managerId String?  @map("manager_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  manager   User?    @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  users     User[]   @relation("DepartmentMembers")

  @@index([companyId])
  @@map("departments")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique @map("email")
  name         String         @map("name")
  passwordHash String         @map("password_hash")
  role         Role           @default(COLLABORATOR) @map("role")
  companyId    String         @map("company_id")
  departmentId String?        @map("department_id")
  position     String?        @map("position")
  locale       String         @default("es") @map("locale")
  avatar       String?        @map("avatar")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department   Department?    @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepts Department[]   @relation("DepartmentManager")

  taughtCourses Course[]      @relation("CourseInstructor")
  enrollments   Enrollment[]
  progress      UserProgress[]
  quizAttempts  QuizAttempt[]
  grades        Grade[]
  certificates  Certificate[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([companyId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model CourseCategory {
  id          String           @id @default(cuid())
  name        String           @map("name")
  description String?          @map("description")
  parentId    String?          @map("parent_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  parent      CourseCategory?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    CourseCategory[] @relation("SubCategories")
  courses     Course[]

  @@map("course_categories")
}

model Course {
  id             String           @id @default(cuid())
  title          String           @map("title")
  description    String?          @map("description")
  thumbnail      String?          @map("thumbnail")
  status         CourseStatus     @default(DRAFT) @map("status")
  difficulty     CourseDifficulty @default(BEGINNER) @map("difficulty")
  estimatedHours Float?           @map("estimated_hours")
  passingScore   Float            @default(80.0) @map("passing_score")
  instructorId   String?          @map("instructor_id")
  categoryId     String?          @map("category_id")
  archivedAt     DateTime?        @map("archived_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  instructor     User?            @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  category       CourseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  assignedCompanies CourseCompany[]
  modules           Module[]
  enrollments       Enrollment[]
  grades            Grade[]
  certificates      Certificate[]

  @@index([status])
  @@index([instructorId])
  @@index([categoryId])
  @@map("courses")
}

model CourseCompany {
  id        String   @id @default(cuid())
  courseId  String   @map("course_id")
  companyId String   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([courseId, companyId])
  @@index([companyId])
  @@index([courseId])
  @@map("course_companies")
}

model Module {
  id          String   @id @default(cuid())
  title       String   @map("title")
  description String?  @map("description")
  position    Int      @default(0) @map("position")
  courseId    String   @map("course_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId, position])
  @@map("modules")
}

model Lesson {
  id          String        @id @default(cuid())
  title       String        @map("title")
  type        LessonType    @default(TEXT) @map("type")
  content     String?       @map("content")
  position    Int           @default(0) @map("position")
  duration    Int?          @map("duration")
  isRequired  Boolean       @default(true) @map("is_required")
  moduleId    String        @map("module_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources   Resource[]
  quizzes     Quiz[]
  progress    UserProgress[]
  grades      Grade[]

  @@index([moduleId, position])
  @@map("lessons")
}

model Resource {
  id             String       @id @default(cuid())
  title          String       @map("title")
  type           ResourceType @map("type")
  fileUrl        String       @map("file_url")
  convertedPdfUrl String?     @map("converted_pdf_url")
  fileName       String       @map("file_name")
  fileSize       Int          @map("file_size")
  lessonId       String       @map("lesson_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("resources")
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  courseId    String           @map("course_id")
  status      EnrollmentStatus @default(ACTIVE) @map("status")
  enrolledAt  DateTime         @default(now()) @map("enrolled_at")
  completedAt DateTime?        @map("completed_at")
  enrolledBy  String?          @map("enrolled_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([userId, status])
  @@map("enrollments")
}

model UserProgress {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  lessonId     String    @map("lesson_id")
  isCompleted  Boolean   @default(false) @map("is_completed")
  completedAt  DateTime? @map("completed_at")
  timeSpent    Int       @default(0) @map("time_spent")
  lastAccessed DateTime  @default(now()) @map("last_accessed")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
  @@index([lessonId])
  @@map("user_progress")
}

model Quiz {
  id               String        @id @default(cuid())
  title            String        @map("title")
  description      String?       @map("description")
  passingScore     Float         @default(70.0) @map("passing_score")
  maxAttempts      Int           @default(3) @map("max_attempts")
  timeLimit        Int?          @map("time_limit")
  shuffleQuestions Boolean       @default(false) @map("shuffle_questions")
  lessonId         String        @map("lesson_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  lesson           Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions        Question[]
  attempts         QuizAttempt[]

  @@index([lessonId])
  @@map("quizzes")
}

model Question {
  id            String       @id @default(cuid())
  quizId        String       @map("quiz_id")
  type          QuestionType @default(MULTIPLE_CHOICE) @map("type")
  text          String       @map("text")
  options       Json?        @map("options")
  correctAnswer Json?        @map("correct_answer")
  points        Float        @default(1.0) @map("points")
  position      Int          @default(0) @map("position")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers       Answer[]

  @@index([quizId, position])
  @@map("questions")
}

model QuizAttempt {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  quizId        String    @map("quiz_id")
  score         Float?    @map("score")
  attemptNumber Int       @default(1) @map("attempt_number")
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz          Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers       Answer[]
  grades        Grade[]

  @@index([userId, quizId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model Answer {
  id             String      @id @default(cuid())
  attemptId      String      @map("attempt_id")
  questionId     String      @map("question_id")
  selectedAnswer Json?       @map("selected_answer")
  isCorrect      Boolean?    @map("is_correct")
  pointsAwarded  Float?      @map("points_awarded")
  feedback       String?     @map("feedback")
  createdAt      DateTime    @default(now()) @map("created_at")

  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}

model Grade {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  courseId      String       @map("course_id")
  lessonId      String?      @map("lesson_id")
  quizAttemptId String?      @map("quiz_attempt_id")
  score         Float        @map("score")
  maxScore      Float        @map("max_score")
  percentage    Float        @map("percentage")
  gradedBy      String?      @map("graded_by")
  gradedAt      DateTime     @default(now()) @map("graded_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson        Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  quizAttempt   QuizAttempt? @relation(fields: [quizAttemptId], references: [id], onDelete: SetNull)

  @@index([userId, courseId])
  @@index([courseId])
  @@map("grades")
}

model Certificate {
  id                String   @id @default(cuid())
  certificateNumber String   @unique @map("certificate_number")
  title             String   @map("title")
  userId            String   @map("user_id")
  courseId          String   @map("course_id")
  finalGrade        Float    @map("final_grade")
  issuedAt          DateTime @default(now()) @map("issued_at")
  templateId        String?  @map("template_id")
  pdfUrl            String?  @map("pdf_url")
  createdAt         DateTime @default(now()) @map("created_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType @default(SYSTEM) @map("type")
  title     String           @map("title")
  message   String           @map("message")
  isRead    Boolean          @default(false) @map("is_read")
  linkUrl   String?          @map("link_url")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   @map("action")
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?    @map("metadata")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}
