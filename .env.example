# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/academy_lms

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email (Outlook / Microsoft 365 SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Almacenamiento — NUNCA una ruta dentro de /public: los archivos solo deben
# poder leerse a través de src/app/api/uploads/[...path]/route.ts (control de
# acceso multi-empresa + streaming con Range Requests), nunca servidos como
# estáticos sin autenticación.
UPLOADS_DIR=./storage/uploads
MAX_VIDEO_SIZE_MB=200
MAX_DOCUMENT_SIZE_MB=25
MAX_IMAGE_SIZE_MB=10

# Conversión de PPTX a PDF (opcional; requiere LibreOffice instalado en el
# servidor). Si el binario no existe o la conversión falla, el archivo PPTX
# se sigue guardando y se puede descargar, solo no se genera vista previa.
LIBREOFFICE_PATH=soffice

# Integración CorpoSuite: puente de identidad SIGE -> Academy (ver PLAN.md)
# Debe ser exactamente el mismo valor que ACADEMY_SERVICE_TOKEN en backend/.env de SIGE.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGE_SERVICE_TOKEN=
